<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>kz.store</groupId>
  <artifactId>cash</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>cash</name>
  <description>Store cash application</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.7</javafx.version>
    <lombok.version>1.18.34</lombok.version>
    <!-- Патч-версии внутри линейки Boot 3.5.16 (BOM даёт jackson 2.21.4 / logback 1.5.34):
         закрывают замечания Mend.io. Убрать переопределения, когда BOM Boot догонит. -->
    <jackson-bom.version>2.21.8</jackson-bom.version>
    <logback.version>1.5.38</logback.version>
    <!-- Отдельное имя на время перехода на SQLite: разное имя -> разный каталог установки
         и разный ярлык в Пуск, чтобы установка этой сборки не трогала уже работающую версию
         на Postgres. Когда переход завершится и старая версия будет выведена из
         эксплуатации, верните "CashStore" обратно, чтобы новые сборки обновляли себя же,
         а не копились рядом как отдельные продукты. -->
    <app.name>CashStore-SQLite</app.name>
    <installer.version>0.0.1</installer.version>
  </properties>

  <dependencies>

    <!-- десктоп-вариант -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.53.4.0</version>
      <scope>runtime</scope>
    </dependency>
    <!-- SQLite Hibernate-диалект — не входит в hibernate-core, версия берётся из BOM Spring Boot -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- JavaFX -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- Ikonli -->
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-javafx</artifactId>
      <version>12.3.1</version>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-fontawesome5-pack</artifactId>
      <version>12.3.1</version>
    </dependency>

    <!-- Flyway: SQLite поддерживается прямо в flyway-core, отдельный модуль не нужен -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>11.10.1</version>
    </dependency>

    <!-- MapStruct -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>1.5.5.Final</version>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct-processor</artifactId>
      <version>1.5.5.Final</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Java 22 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>${java.version}</release>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>1.5.5.Final</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Amapstruct.defaultComponentModel=spring</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- Покрытие тестами: отчёт в target/site/jacoco после mvn verify -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Spring Boot: делаем fat-jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>kz.store.cash.MainCashApplication</mainClass>
          <layers enabled="true"/>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Стаджим ГОТОВЫЙ fat-jar из target/ в target/app -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>stage-boot-jar</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <overwrite>true</overwrite>
              <outputDirectory>${project.build.directory}/app</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}</directory>
                  <includes>
                    <include>${project.build.finalName}.jar</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- JavaFX: dev-run по желанию -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>kz.store.cash.MainCashApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <id>run</id>
            <goals>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- jpackage: EXE (можно сменить на APP_IMAGE) -->
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <version>1.6.6</version>
        <configuration>
          <name>${app.name}</name>
          <vendor>Yestay</vendor>
          <appVersion>${installer.version}</appVersion>

          <input>${project.build.directory}/app</input>
          <mainJar>${project.build.finalName}.jar</mainJar>
          <!-- опционально, но не помешает -->
          <mainClass>org.springframework.boot.loader.launch.JarLauncher</mainClass>

          <runtimeImage>${java.home}</runtimeImage>

          <type>EXE</type> <!-- или APP_IMAGE -->
          <winShortcut>true</winShortcut>
          <winMenu>true</winMenu>
          <winPerUserInstall>true</winPerUserInstall>
          <destination>${project.build.directory}/dist</destination>
          <removeDestination>true</removeDestination>
          <!-- Отдельный UpgradeCode для этой (SQLite) сборки — гарантирует, что Windows
               Installer видит её как самостоятельный продукт, а не как обновление уже
               установленной версии на Postgres, и не трогает её файлы/ярлык при установке. -->
          <winUpgradeUuid>7c57f709-6251-473d-840e-11ce10e0c6d1</winUpgradeUuid>

          <icon>${project.basedir}/src/main/resources/icons/app.ico</icon>

          <javaOptions>
            <javaOption>-Dfile.encoding=UTF-8</javaOption>
            <javaOption>-Djavafx.preloader=kz.store.cash.config.AppPreloader</javaOption>
            <!--            <javaOption>-Dspring.config.additional-location=$APPDIR/config/</javaOption>-->
          </javaOptions>
          <!-- Включи, если нужно видеть вывод при старте EXE -->
          <!--          <winConsole>true</winConsole>-->
        </configuration>
        <executions>
          <execution>
            <id>jpackage</id>
            <goals>
              <goal>jpackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>